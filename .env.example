# =============================================================================
# Navedesk - exemplo de variáveis de ambiente
# Copie este arquivo para `.env` (ignorado pelo Git) e ajuste os valores.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (consumido pelo serviço `db` do docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=navedesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=navedesk

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# String de conexão usada pelo Drizzle/pg.
#  - Dentro do docker-compose o host é `db` (rede interna do Compose).
#  - Para rodar o app localmente fora do Compose, use `localhost`.
DATABASE_URL=postgres://navedesk:changeme@db:5432/navedesk

# Tamanho máximo do pool `pg` (default 10). Ajuste conforme carga/recursos.
DATABASE_POOL_MAX=10

# Segredo usado pelo Auth.js para assinar JWT/cookies.
# Substitua pelo output de:  openssl rand -base64 32
AUTH_SECRET=generate-a-32-byte-random-string

# URL pública da aplicação (usada pelo Auth.js em callbacks).
# Em rede interna, troque para o IP do servidor (ex.: http://192.168.1.50:4001)
# para que o Auth.js valide o cookie corretamente vindo de outras máquinas.
AUTH_URL=http://localhost:4001

# Quando o app é servido por HTTP em LAN (sem TLS), defina como `true`
# para desativar o flag `secure` dos cookies de sessão. Sem isso, o
# navegador descarta o cookie e o usuário entra em loop de login.
# Em deploy com HTTPS válido, omita ou deixe `false`.
AUTH_INSECURE_COOKIES=true

# -----------------------------------------------------------------------------
# Upload de anexos
# -----------------------------------------------------------------------------
# Diretório onde o storage local persiste os arquivos enviados.
# Em Docker o caminho é absoluto dentro do container.
UPLOAD_DIR=/app/public/uploads

# Tamanho máximo aceito por arquivo, em bytes (25 MiB = 26214400).
UPLOAD_MAX_BYTES=26214400
